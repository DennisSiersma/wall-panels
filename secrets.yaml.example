# Kopieer dit bestand naar secrets.yaml (in je ESPHome-configmap) en vul in.
# secrets.yaml staat in .gitignore en wordt NOOIT gecommit.

wifi_ssid: "JouwSSID"
wifi_password: "JouwWifiWachtwoord"

# Genereer een NIEUWE key (bijv. `openssl rand -base64 32`). De oude key is
# gedeeld geweest, dus roteer 'm.
api_key: "VERVANG_DOOR_NIEUWE_BASE64_KEY"

# Kies sterke, nieuwe wachtwoorden (oude waren hardcoded en gedeeld).
ota_password: "VERVANG_DOOR_STERK_WACHTWOORD"
ap_password: "VERVANG_DOOR_STERK_WACHTWOORD"
